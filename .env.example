# Supabase — copy to `.env.local` for local development
# https://supabase.com/dashboard/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only: Stripe webhook writes `rivet_purchases` (never expose in the browser)
# SUPABASE_SERVICE_ROLE_KEY=

# Public site URL for Stripe Checkout return URLs (production domain, e.g. https://app.example.com)
# NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Local only: skip sign-in — middleware + /login redirect straight to the app (never in prod).
# Works without Supabase keys; UI uses a mock user. Saving data still needs real keys + /login?signin=1
DEV_BYPASS_AUTH=true

# Stripe — one-time Rivet license (see LAUNCH_CHECKLIST.md)
# When STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, STRIPE_RIVET_ONE_TIME_PRICE_ID,
# SUPABASE_SERVICE_ROLE_KEY, and NEXT_PUBLIC_SUPABASE_URL are all set, middleware
# enforces a paid `rivet_purchases` row (except exempt paths like /subscribe, /setup).
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_RIVET_ONE_TIME_PRICE_ID=price_...
# STRIPE_ALLOW_LIVE_KEYS=true   # required only for sk_live_… (see src/lib/billing/stripe-test-mode.ts)

# Optional: AI Quick Capture on /sops/capture (uses gpt-4o-mini by default)
# OPENAI_API_KEY=sk-...
# OPENAI_QUICK_CAPTURE_MODEL=gpt-4o-mini
# OPENAI_WHISPER_MODEL=whisper-1

# Scan report email (Resend) — PDF + hosted link at /report/{id}
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Rivet Reports <reports@rivet.app>

# QA: skip paywall + Stripe Checkout (setup → onboarding → app without payment). Remove before launch.
# RIVET_BILLING_DISABLED=true

# Production-only: comma-separated emails allowed to open /internal/billing-check
# RIVET_INTERNAL_ADMIN_EMAILS=you@company.com, cofounder@company.com
